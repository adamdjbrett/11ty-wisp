{
  "name": "11ty-wisp",
  "version": "1.0.1",
  "description": "11ty Wisp by Adam DJ Brett",
  "type": "module",
  "scripts": {
    "build": "buildawesome",
    "build-nocolor": "cross-env NODE_DISABLE_COLORS=1 buildawesome",
    "build-ghpages": "buildawesome --pathprefix=/11ty-wisp/",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "preview": "npm run build && npx wrangler@4 dev",
    "dev": "buildawesome --serve --quiet --port=8080",
    "start": "npm run dev",
    "start-ghpages": "buildawesome --pathprefix=/11ty-wisp/ --serve --quiet --port=8080",
    "debug": "cross-env DEBUG=Eleventy* buildawesome",
    "debugstart": "cross-env DEBUG=Eleventy* buildawesome --serve --quiet --port=8080",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* buildawesome"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/adamdjbrett/11ty-wisp.git"
  },
  "author": {
    "name": "Adam DJ Brett",
    "email": "info@adamdjbrett.com",
    "url": "https://adamdjbrett.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11.14.0"
  },
  "devDependencies": {
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@anyblades/blades": "^3.0.0-alpha.3",
    "@awesome.me/buildawesome": "^4.0.0-alpha.10",
    "@zachleat/heading-anchors": "^1.0.5",
    "clean-css": "^5.3.3",
    "cross-env": "^10.1.0",
    "js-yaml": "^5.4.1",
    "luxon": "^3.7.2",
    "pagefind": "^1.5.2",
    "zod": "^4.5.4",
    "zod-validation-error": "^5.0.0"
  },
  "packageManager": "npm@12.0.0"
}
