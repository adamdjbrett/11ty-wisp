# Cloudflare (Pages / Workers static assets) response headers.
# Passthrough-copied from public/ to the root of _site/ at build time.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Eleventy bundle output is content-hashed (/dist/<hash>.css|.js),
# so a new build always produces a new URL.
/dist/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800
